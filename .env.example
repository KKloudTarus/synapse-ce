# Synapse configuration – copy to `.env` and adjust. NEVER commit real secrets.
#
# Synapse reads the PROCESS ENVIRONMENT directly; it does NOT auto-load this file.
# Load it into your shell first:   set -a; source .env; set +a
# (or pass it via Docker --env-file / Compose env_file / your process manager).
#
# Conventions: empty value = unset (the built-in default applies); booleans accept
# 1/0/true/false; durations use Go syntax (30s, 10m, 1h); sizes are byte counts.
# Values shown below are the defaults unless noted. Commented lines document an
# option without enabling it. Full reference: docs/guide/configuration.md.

# =============================================================================
# REQUIRED before the server will start
# =============================================================================
# Bootstrap-admin bearer token – the API exits if this is empty. Operational API
# routes require it; GET /healthz and GET /readyz are intentionally public. Generate: openssl rand -hex 32
SYNAPSE_API_TOKEN=

# Optional browser OIDC BFF. Discovery is pinned to this HTTPS issuer; identities must already
# be linked in the fixed tenant. Provider tokens and claims are neither persisted nor logged.
# SYNAPSE_OIDC_ENABLED=false
# SYNAPSE_OIDC_ISSUER=https://issuer.example
# SYNAPSE_OIDC_CLIENT_ID=
# SYNAPSE_OIDC_CLIENT_SECRET=
# SYNAPSE_OIDC_REDIRECT_URL=https://synapse.example/api/auth/oidc/callback
# SYNAPSE_OIDC_FRONTEND_URL=https://synapse.example/
# SYNAPSE_OIDC_TENANT_ID=default
# SYNAPSE_OIDC_GROUP_ROLE_MAPPING=synapse-admins=admin,synapse-reviewers=reviewer
# SYNAPSE_OIDC_TRANSACTION_TTL=10m
# SYNAPSE_OIDC_SESSION_TTL=8h

# =============================================================================
# Core / server
# =============================================================================
SYNAPSE_HTTP_ADDR=:8080
# Deployment env. Non-prod: development|dev|local|test|ci. ANYTHING ELSE (incl.
# typos, "staging", "production") is treated as production and enables the strict,
# fail-closed gates (vault key + signing seed + sandbox become mandatory).
SYNAPSE_ENV=development
SYNAPSE_LOG_LEVEL=info
SYNAPSE_SINGLE_TENANT=true
# Prometheus /metrics on a SEPARATE, uninstrumented, non-bearer-protected listener.
# Off by default; when enabled the listener stays loopback-only unless you widen it –
# do not expose it beyond a private scrape network. See docs/guide/configuration.md
# for the metric names and the label/privacy policy.
SYNAPSE_METRICS_ENABLED=false
SYNAPSE_METRICS_ADDR=127.0.0.1:9090
# One structured "http access" log event per request (method, matched route, status,
# latency, request id, and the resolved principal id when authenticated). Never logs
# raw paths, queries, headers, bodies, or secrets. On by default.
SYNAPSE_ACCESS_LOG_ENABLED=true
# Acceptable-Use Policy version operators must accept on first run.
SYNAPSE_AUP_VERSION=1.0
# File-backed paths used only in in-memory mode (no SYNAPSE_DB_DSN).
SYNAPSE_AUP_FILE=data/aup-accepted.json
SYNAPSE_AUDIT_FILE=data/audit.jsonl

# Required in production. HMAC key used to sign Measures pagination cursors.
# Generate with: openssl rand -hex 32
SYNAPSE_MEASURE_CURSOR_SECRET=

# =============================================================================
# Persistence – PostgreSQL (empty DSN ⇒ mixed in-memory + local-file dev stores)
# =============================================================================
# The `make docker-up` stack uses user, password, and database all set to "synapse";
# put the user + password into the userinfo slot of the URL, e.g.
#   postgres://USER:PASSWORD@localhost:5432/synapse?sslmode=disable
SYNAPSE_DB_DSN=postgres://localhost:5432/synapse?sslmode=disable
# pgx connection-pool sizing.
# SYNAPSE_DB_MAX_CONNS=32
# SYNAPSE_DB_MIN_CONNS=0
# SYNAPSE_DB_MAX_CONN_LIFETIME=1h
# SYNAPSE_DB_MAX_CONN_IDLE=30m
# Optional owner-level DSN used only for embedded migrations; keeps the runtime
# identity least-privileged. Empty falls back to SYNAPSE_DB_DSN.
# SYNAPSE_DB_MIGRATION_DSN=
# Set false in production: synapse-migrate owns migrations. API exposes /readyz;
# worker and MCP refuse startup until migrations are current.
SYNAPSE_DB_AUTO_MIGRATE=true

# =============================================================================
# Evidence blob store – MinIO / S3 (empty endpoint ⇒ in-memory dev store)
# =============================================================================
# Endpoint is host:port WITHOUT a scheme; set USE_SSL=true for https.
# Values below match the `make docker-up` MinIO.
SYNAPSE_BLOB_ENDPOINT=localhost:9000
SYNAPSE_BLOB_ACCESS_KEY=synapse
SYNAPSE_BLOB_SECRET_KEY=synapse-secret
SYNAPSE_BLOB_BUCKET=synapse-evidence
SYNAPSE_BLOB_USE_SSL=false

# =============================================================================
# Custody, signing & anchoring  (the two keys are REQUIRED in production)
# =============================================================================
# AES-256 credential-vault master key: 64 hex chars or base64 of 32 bytes.
# Empty ⇒ ephemeral dev key (stored secrets do NOT survive a restart). Never logged.
SYNAPSE_VAULT_MASTER_KEY=
# ed25519 seed attesting evidence + audit chain heads (stable key id across restarts).
# Empty ⇒ ephemeral key. Never logged.
SYNAPSE_EVIDENCE_SIGNING_SEED=
# Dedicated Ed25519 authority for process-bound worker egress grants. Production API
# serves this only on a private listener; worker uses a distinct machine bearer token.
# Never reuse SYNAPSE_API_TOKEN or SYNAPSE_EVIDENCE_SIGNING_SEED.
# SYNAPSE_EGRESS_GRANT_AUTHORITY_ADDR=127.0.0.1:8082
# SYNAPSE_EGRESS_GRANT_ISSUER_TOKEN=
# SYNAPSE_EGRESS_GRANT_SIGNING_SEED=
# SYNAPSE_EGRESS_GRANT_AUTHORITY_URL=https://synapse-api.internal/internal/v1/egress-grants
# SYNAPSE_EGRESS_GRANT_AUTHORITY_TOKEN=
# RFC-3161 timestamp authority for external anchoring (tamper-PROOF). Empty ⇒
# signed-but-not-anchored (still tamper-evident).
# SYNAPSE_TSA_URL=

# =============================================================================
# Software Composition Analysis
# =============================================================================
# SBOM producer: "syft" (pinned binary, full coverage + dep-graph edges) or
# "ownsbom" (detection-independent owned parsers; components-only).
SYNAPSE_SBOM_PRODUCER=syft
# Tool binaries (resolved on PATH by default).
# SYNAPSE_SYFT_BIN=syft
# SYNAPSE_GRYPE_BIN=grype           # missing ⇒ degrades to OSV-only
# Pin Grype's vuln DB to a pre-synced dir for offline + reproducible scans (empty ⇒ online).
# SYNAPSE_GRYPE_DB_DIR=
# Per-scan timeout (0 disables) and the lowest severity promoted to a finding.
# SYNAPSE_SCAN_TIMEOUT=10m
# SYNAPSE_FINDING_MIN_SEVERITY=info   # critical|high|medium|low|info (default info promotes all; set high to tighten the floor)
# Max total size of a prepared scan workspace (bytes); a bigger target/archive is rejected.
# Lower for CI, raise for a large monorepo. <=0 keeps the 2 GiB default.
# SYNAPSE_MAX_WORKSPACE_BYTES=2147483648
# Match the SBOM against the owned advisory store (offline) alongside OSV/Grype.
# ON by default; a no-op until you populate it:  synapse-cli sync-advisories <dir>|--remote|--csaf <dir>
SYNAPSE_OWNED_ADVISORY=true
# Feed overrides (tests / mirrors); empty ⇒ public endpoints.
# SYNAPSE_OSV_URL=
# SYNAPSE_OSV_BULK_URL=
# SYNAPSE_DEPSDEV_URL=
# SYNAPSE_KEV_URL=
# SYNAPSE_EPSS_URL=

# =============================================================================
# Scanning capabilities  (ON by default – set a flag to false to opt out)
# =============================================================================
# Every deterministic, best-effort analysis capability is ON by default so the
# tool is fully effective out of the box (the UI and a bare scan get the full
# feature set). Each is a no-op when its input is absent. Set =false to disable.
#
# Secret scanning: regex + entropy over the workspace; matches are redacted.
SYNAPSE_SECRET_SCAN_ENABLED=true
# Misconfiguration / IaC scanning: Dockerfile + Kubernetes manifests.
SYNAPSE_MISCONFIG_ENABLED=true

# Live cloud posture (read-only; credentials are stored in the engagement vault by reference).
# Requires PostgreSQL + synapse-worker + fleet assets + sandbox/egress enforcement.
SYNAPSE_CSPM_ENABLED=false
SYNAPSE_CSPM_PROVIDERS=
# 0 uses provider defaults; otherwise requests per second (1..100).
SYNAPSE_CSPM_RATE=0
# When enabled, use an absolute helper path and pin its SHA-256 in SYNAPSE_TOOL_HASHES.
SYNAPSE_CSPM_HELPER_BIN=synapse-cspm
# Provider-qualified default-deny HTTPS allowlist entries: provider=hostname.
# Include provider identity/token, hierarchy, compute/network, storage, and IAM endpoints.
SYNAPSE_CSPM_EGRESS_HOSTS=
# Compliance benchmark: re-project findings onto a control spec (PASS/FAIL).
SYNAPSE_COMPLIANCE_ENABLED=true
# Honor a repo .synapseignore accepted-risk file (retain-and-mark; gate-exempt only).
SYNAPSE_SUPPRESSION_ENABLED=true
# Consume an in-repo OpenVEX doc (.synapse.vex.json) at scan time.
SYNAPSE_VEX_ENABLED=true
# Container image rootfs: materialize the image FS so the owned OS-package
# catalogers (dpkg/apk + rpm sqlite rpmdb) and installed-binary catalogers
# (Go buildinfo, Python dist-info) can run. Best-effort; image scans only.
SYNAPSE_IMAGE_ROOTFS_ENABLED=true
# Scan caches: skips re-cataloging an unchanged SBOM and safely reuses server AI-triage
# claims only when tenant/scope, finding, complete source, context, models, prompt,
# and policy all match. The cache dir MUST be operator-owned (per-user default is safe).
SYNAPSE_SCAN_CACHE_ENABLED=true
# SYNAPSE_SCAN_CACHE_DIR=            # empty ⇒ a per-user cache location
# (Pattern SAST + the judgment analyzers are in the "Analysis brain" section below.)
#
# Detection tuning – the defaults are already the thorough choice:
# comprehensive (default) reports every match; precise quarantines single-source
# non-KEV findings into a needs-verify queue (still reported + sealed, gate-exempt).
# SYNAPSE_DETECTION_PRIORITY=comprehensive   # comprehensive|precise
# Warn when a dated reference DB (KEV/EPSS/Grype) is older than N days (0 disables).
# SYNAPSE_DB_MAX_AGE_DAYS=30
# Skip the live advisory source; detect offline only (off = more recall).
# SYNAPSE_OFFLINE=false
# Drop vulnerabilities with no fixed version (off = show everything).
# SYNAPSE_IGNORE_UNFIXED=false

# =============================================================================
# Fleet attack paths (requires SYNAPSE_FLEET_ASSETS_ENABLED=true)
# =============================================================================
# Traversal always enforces and reports all three bounds.
# SYNAPSE_ATTACKPATH_MAX_LEN=12
# SYNAPSE_ATTACKPATH_MAX_PATHS=100
# SYNAPSE_ATTACKPATH_WALLCLOCK=2s

# =============================================================================
# Recon & execution sandbox  (sandbox is REQUIRED in production)
# =============================================================================
# Run tool execution + acquisition in the bubblewrap sandbox. Production requires
# this to be true; if bubblewrap is unavailable, startup FAILS CLOSED.
SYNAPSE_SANDBOX_ENABLED=false
# Per-run cgroup limits (bytes / pid count).
# SYNAPSE_SANDBOX_MEM_MAX=536870912    # 512 MiB
# SYNAPSE_SANDBOX_PIDS_MAX=256
# Authoritative sha256 pins "name=hex,/abs/path=hex,…"; the sandbox refuses a
# binary whose hash doesn't match. Empty ⇒ trust-on-first-use.
# SYNAPSE_TOOL_HASHES=
# Recon worker pool + per-run bounds.
# SYNAPSE_RECON_TIMEOUT=3m
# SYNAPSE_RECON_MAX_OUTPUT=8388608     # 8 MiB
# SYNAPSE_RECON_CONCURRENCY=3
# SYNAPSE_RECON_QUEUE=64
# Permit capability-sensitive tools (e.g. naabu / raw sockets).
# SYNAPSE_RECON_ALLOW_CAPABILITY_SENSITIVE=false
# Route recon through the durable queue to synapse-worker (requires Postgres).
# SYNAPSE_RECON_VIA_WORKER=false

# =============================================================================
# AI agent orchestration  (off by default)
# =============================================================================
# SYNAPSE_AGENT_ENABLED=false
# OpenAI-compatible Chat Completions endpoint + credentials. The key is never logged.
# SYNAPSE_LLM_BASE_URL=http://localhost:20128/v1
# SYNAPSE_LLM_API_KEY=
# Explicit provider identity used for audit/separation-of-duties; it is not inferred from the URL.
# SYNAPSE_LLM_PROVIDER=openai-compatible
# SYNAPSE_LLM_MODEL=                   # REQUIRED when the agent is enabled
# SYNAPSE_LLM_TIMEOUT=60s
# Distinct verifier model. When set to a model DIFFERENT from SYNAPSE_LLM_MODEL, it powers the automated
# LLM judgment-verifier: POST /engagements/{id}/judgments/auto-verify has this model independently score
# each PROPOSED gated judgment (reachability/sast/critique/threat/vex) and seal a verdict via the same
# gate a human reviewer uses (verifier identity "llm:<model>", never the proposer → no self-confirm). It
# also enables the FP-triage two-model consensus. Defaults to SYNAPSE_LLM_MODEL (= no distinct verifier).
# The verifier transport defaults to the proposer transport, but can use a separate endpoint/key/provider.
# Keys are never logged. Set all provider metadata explicitly before requiring provider independence.
# SYNAPSE_VERIFIER_BASE_URL=http://localhost:20128/v1
# SYNAPSE_VERIFIER_API_KEY=
# Defaults to SYNAPSE_FP_TRIAGE_PROVIDER. Set a distinct explicit value to satisfy provider policy.
# SYNAPSE_VERIFIER_PROVIDER=openai-compatible
# SYNAPSE_VERIFIER_MODEL=
# AI false-positive analysis: after a scan, the proposer critiques production-scope first-party
# SAST/misconfig findings. Secret findings and their raw source context never enter the LLM transcript.
# A high-confidence "refuted" verdict is advisory and never deletes a finding. Gate exemption requires a
# DIFFERENT SYNAPSE_VERIFIER_MODEL to independently refute at/above the bar. Even then, high/critical,
# secret, and dangerous-CWE findings stay gating for human review. The typed proposer/verifier verdicts,
# model IDs, prompt version, policy decision, and gate authorization are sealed with the scan evidence.
# Without a distinct verifier OR a configured evidence ledger the feature remains advisory-only.
# SYNAPSE_FP_TRIAGE_ENABLED=false
# SYNAPSE_FP_TRIAGE_MODEL=
# Defaults to SYNAPSE_LLM_PROVIDER; set explicitly when the routed triage model uses another provider.
# SYNAPSE_FP_TRIAGE_PROVIDER=openai-compatible
# Rollout authority: shadow records would_gate_exempt but always keeps findings gating. enforce permits
# the normal verified-consensus policy to set gate_exempt. Unknown values fail closed to shadow.
# SYNAPSE_FP_TRIAGE_MODE=shadow
# model_family (default) requires a different canonical model family. provider additionally requires a
# different explicit provider. Unknown values fail closed to advisory-only.
# SYNAPSE_FP_TRIAGE_INDEPENDENCE=model_family
# HITL approval: manual (human approves every action) | filter | auto.
# SYNAPSE_AGENT_APPROVAL_MODE=manual
# SYNAPSE_AGENT_APPROVAL_TIMEOUT=30m   # fail-closed timeout
# Per-run bounds.
# SYNAPSE_AGENT_MAX_STEPS=16
# SYNAPSE_AGENT_TOKEN_BUDGET=0         # 0 = unbounded
# SYNAPSE_AGENT_MAX_DURATION=10m
# Durable agent on synapse-worker (requires SYNAPSE_RECON_VIA_WORKER + Postgres).
# SYNAPSE_AGENT_VIA_WORKER=false
# Inline-agent admission + plan-DAG parallelism.
# SYNAPSE_AGENT_CONCURRENCY=8
# SYNAPSE_AGENT_QUEUE_DEPTH=256        # over ⇒ 503
# SYNAPSE_AGENT_MAX_PARALLEL=1         # in-flight plan nodes (serial by default)
# SYNAPSE_AGENT_RECON_CONCURRENCY=3
# SYNAPSE_APPROVAL_SWEEP_INTERVAL=1m

# =============================================================================
# Analysis brain  (deterministic parts ON by default; the parts needing the
# sandbox or the agent stay opt-in – all are best-effort, no-op without inputs)
# =============================================================================
# JUDGMENTS_ENABLED is the prerequisite for the analyzers that mint judgments;
# it and the deterministic analyzers default ON. Set a flag =false to opt out.
SYNAPSE_JUDGMENTS_ENABLED=true       # judgment lifecycle routes (verify/accept/list)
SYNAPSE_SAST_ENABLED=true            # pattern-SAST in the scan pipeline
SYNAPSE_REACHABILITY_ENABLED=true    # Tier-2 call-graph reachability proof (govulncheck; best-effort)
SYNAPSE_JVM_REACHABILITY_ENABLED=true # JVM (Java/Kotlin) reachability
# SYNAPSE_PYREACH_ENABLED=false      # Tier-1 Python import-reachability (dead-dependency → OpenVEX not_affected)
# SYNAPSE_JSREACH_ENABLED=false      # JS/TS reachability (Tier-1 import-level)
# SYNAPSE_JSREACH_TIER2_ENABLED=false # JS/TS symbol-level (Tier-2) reachability
SYNAPSE_CROSSCHECK_ENABLED=true      # detection-source disagreement judgments
SYNAPSE_SBOM_CROSSCHECK_ENABLED=true # dual-producer SBOM cross-check
SYNAPSE_GOMODGRAPH_ENABLED=true      # transitive Go dep edges via `go mod graph`
# SYNAPSE_GOVULNCHECK_BIN=govulncheck
# SYNAPSE_GO_BIN=go
# Opt-in – these need external setup:
# SYNAPSE_TAINT_ENABLED=false          # taint CapSAST proposals – needs Judgments + the sandbox
# SYNAPSE_TAINT_CALLGRAPH_BIN=synapse-callgraph
# SYNAPSE_WRITEUP_DRAFTS_ENABLED=false # agent propose_writeup_draft tool – needs the agent

# =============================================================================
# Fleet & runtime (blue team) – distributed agents, coverage, eBPF detections
# =============================================================================
# All off by default; the fleet needs PostgreSQL + synapse-worker, and the agents
# run on Linux hosts / Kubernetes. Agent-side detection classes are configured on
# the agent process (synapse-agent), not here.
# SYNAPSE_FLEET_ENABLED=false                      # fleet transport + agent-admin routes
# SYNAPSE_FLEET_ASSETS_ENABLED=false               # fleet asset model + attack paths
# SYNAPSE_FLEET_HOST_INGEST_ENABLED=false          # accept host-inventory from agents
# SYNAPSE_FLEET_CLUSTER_INGEST_ENABLED=false       # accept Kubernetes inventory from cluster agents
# SYNAPSE_FLEET_STALE_AFTER=10m                    # an agent older than this reads as stale (<=0 disables)
# SYNAPSE_FLEET_COVERAGE_FRESHNESS_TARGET=24h      # coverage freshness SLO
# SYNAPSE_FLEET_MIN_AGENT_VERSION=                 # reject agents below this version (empty = no floor)
# Enrolment PKI + package signing (required to enrol/verify agents; never logged):
# SYNAPSE_FLEET_CA_CERT=
# SYNAPSE_FLEET_CA_KEY=
# SYNAPSE_FLEET_CERT_TTL=24h
# SYNAPSE_FLEET_SIGNER_KEY=
# Trust a client-certificate header ONLY behind a proxy that strips user-supplied
# copies and sets it after mTLS verification.
# SYNAPSE_FLEET_CLIENT_CERT_HEADER=
# Optional Ed25519 public-key override for a controlled private update channel.
# SYNAPSE_UPDATE_PUBLIC_KEY=
# Agent processes (not the API): prefer a root-readable token file; remove it
# after first enrolment. The command-line token flag is visible in ps/history.
# SYNAPSE_FLEET_URL=https://synapse.example.com
# SYNAPSE_FLEET_ENROL_TOKEN_FILE=/run/secrets/synapse-enrol-token
# SYNAPSE_AGENT_STATE_DIR=/var/lib/synapse-agent
# SYNAPSE_TELEMETRY_SPOOL_BYTES=536870912             # P0-P3 durable WAL quota (512 MiB)
# SYNAPSE_AGENT_METRICS_ADDR=127.0.0.1:9465           # optional, unauthenticated private scrape listener

# =============================================================================
# Leader election (horizontal scale) – fence scheduled work to one node
# =============================================================================
# Off by default (single-process). Enable when running more than one API/worker so
# scheduled dispatch runs exactly once (fenced lease in Postgres).
# SYNAPSE_LEADER_ENABLED=false
# SYNAPSE_LEADER_RESOURCE=scheduler   # lease name
# SYNAPSE_LEADER_TERM=15s             # lease term
# SYNAPSE_LEADER_RENEW=5s             # renew interval
# SYNAPSE_WORKER_CONCURRENCY=1         # durable queue claim loops per synapse-worker (1-64)

# =============================================================================
# Continuous vulnerability intelligence – fail-closed rollout
# =============================================================================
# Scheduled provider work requires PostgreSQL. Also enable fenced leader election
# above so only one node dispatches and recovers runs.
# SYNAPSE_VULNERABILITY_SCHEDULER_ENABLED=false
# SYNAPSE_VULNERABILITY_SCHEDULER_POLL=1m
# SYNAPSE_VULNERABILITY_SCHEDULER_STALE_AFTER=30m
# SYNAPSE_VULNERABILITY_SCHEDULER_JITTER_PERCENT=10
# SYNAPSE_VULNERABILITY_SCHEDULER_DISPATCH_LIMIT=10
# SYNAPSE_VULNERABILITY_SCHEDULER_MAX_QUEUE_DEPTH=100
# SYNAPSE_VULNERABILITY_SCHEDULER_RECOVERY_LIMIT=10
# Provider sync is global. Tenant mutations additionally require an allowlist entry.
# SYNAPSE_VULNERABILITY_PROVIDER_SYNC_ENABLED=false
# SYNAPSE_VULNERABILITY_OCCURRENCE_WRITES_ENABLED=false
# SYNAPSE_VULNERABILITY_FINDING_PROJECTION_ENABLED=false
# SYNAPSE_VULNERABILITY_ACTIONS_ENABLED=false
# SYNAPSE_VULNERABILITY_NOTIFICATIONS_ENABLED=false
# SYNAPSE_VULNERABILITY_DRY_RUN_ENABLED=true
# SYNAPSE_VULNERABILITY_TENANT_ALLOWLIST=       # tenant-a,tenant-b or *

# =============================================================================
# Risk-based remediation SLA governance – opt-in
# =============================================================================
# Creates versioned, reproducible remediation deadlines for persisted findings and reassesses them
# when continuous vulnerability intelligence changes. Human lifecycle state and accepted-risk
# decisions are never overwritten by scanner/AI refreshes. Reviewer permission is required for
# lifecycle transitions; administrator permission is required to activate a tenant policy.
# SYNAPSE_SLA_ENABLED=false

# =============================================================================
# DAST (authenticated crawling + first-party checks) – bounded, sandboxed
# =============================================================================
# Runs through the governed workflow (scope + HITL + kernel egress). Limits below
# bound the crawler; the defaults are conservative.
# SYNAPSE_DAST_RATE_PER_SEC=5
# SYNAPSE_DAST_CONCURRENCY=4
# SYNAPSE_DAST_MAX_DEPTH=8
# SYNAPSE_DAST_MAX_PAGES=2000
# SYNAPSE_DAST_MAX_WALL_CLOCK=30m
# SYNAPSE_DAST_HELPER_BIN=synapse-dast-helper

# =============================================================================
# MCP server (synapse-mcp) – read + propose-only; never executes
# =============================================================================
# Both are REQUIRED to start synapse-mcp. The token is never logged.
# SYNAPSE_MCP_TOKEN=
# SYNAPSE_MCP_ENGAGEMENT_ID=
# SYNAPSE_MCP_ADDR=:8081
