# Synapse web dashboard images.
#
#   --target production  non-root static server; the Kubernetes ingress routes /api, /healthz,
#                        and /readyz to synapse-api, so this image serves files only.
#   --target compose     the production image plus the server block that does that routing,
#                        for deploy/docker-compose.full.yml, which has no ingress controller.
#   --target dev         Vite dev server. Not used by any Compose stack in this repository; see
#                        the note on the stage.

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.trustLockfile=true
COPY web/ .
RUN pnpm build

# Vite dev server. web/package.json declares no `packageManager` field, so corepack resolves the
# bare `pnpm` command to its own latest-known-good version at run time and downloads it. Preparing
# 11.9.0 into a COREPACK_HOME that the runtime user owns records it as the last known good version,
# so the container starts with the pinned pnpm and no network fetch.
#
# This stage still expects /app to be writable by uid 1000, because pnpm verifies dependency state
# before `pnpm dev` and will try to install. Mounting a host source tree over /app therefore only
# works when that tree is writable by the container user.
FROM node:22-alpine AS dev
WORKDIR /app
ENV COREPACK_HOME=/home/node/.corepack
RUN corepack enable \
    && corepack prepare pnpm@11.9.0 --activate \
    && chown -R node:node "$COREPACK_HOME"
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.trustLockfile=true
COPY web/ .
RUN chown -R node:node /app
USER node
ENV CI=true \
    NPM_CONFIG_TRUST_LOCKFILE=true \
    VITE_API_PROXY_TARGET=http://synapse-api:8080
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5173/ >/dev/null 2>&1 || exit 1
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]

FROM nginxinc/nginx-unprivileged:1.29-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080

# Compose-local dashboard: the production bundle plus the reverse proxy the Kubernetes ingress
# provides in production. The SPA calls same-origin /api/... paths, so without this the dashboard
# loads and every request 404s.
FROM production AS compose
COPY deploy/nginx/compose-dashboard.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
