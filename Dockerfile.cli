# syntax=docker/dockerfile:1
#
# Release image for synapse-cli:
#
#   docker run --rm -v "$PWD:/scan:ro" ghcr.io/kkloudtarus/synapse-cli scan /scan --fail-on high
#
# It builds the binary here rather than consuming a prebuilt one, so a multi-platform build needs no
# per-platform artifact plumbing: every command is pure Go with CGO_ENABLED=0, so one native builder
# cross-compiles both architectures and neither is emulated.
#
# SBOM generation is the OWNED engine (pure Go, in-process), so no third-party SBOM scanner is installed.
# Grype ships as an OPT-IN vulnerability source and nothing selects it by default: without a synced advisory
# store it is the only way this image can match OS-package CVEs, and a scan that has neither says so rather
# than reporting a clean image. Turn it on with SYNAPSE_DETECTION_SOURCES=owned,grype.
#
# This targets the pure-Go SCA/SAST/secret/misconfig path. Sandboxed execution and JVM-from-source resolution
# need a Linux host with bubblewrap and a JDK/Maven/Gradle, which a distroless image does not provide (that is
# deploy/Dockerfile's `full` target).

FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS build
ARG TARGETOS
ARG TARGETARCH
# VERSION is the release tag, embedded so `synapse-cli version` and every report's tool_versions match the
# image tag. It defaults to "dev" so a local build of this file is honest about not being a release.
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath \
    -ldflags "-s -w -X github.com/KKloudTarus/synapse-ce/internal/platform/buildinfo.version=${VERSION}" \
    -o /out/synapse-cli ./cmd/synapse-cli

# This image is built for linux/amd64 AND linux/arm64 by a job that installs no QEMU, so this stage
# must cross-compile from the build platform exactly as the stage above does. A target-platform RUN
# here either fails with exec format error or, where binfmt happens to be registered, emulates a full
# Go build under QEMU.
#
# GRYPE_COMMIT is the commit v0.121.3 points at. A tag is mutable, and the recorded tool_versions have
# to identify the bytes that were actually built.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS grype
ARG TARGETOS
ARG TARGETARCH
RUN apk add --no-cache git
ARG GRYPE_VERSION=v0.121.3
ARG GRYPE_COMMIT=cd1f23eb50dfb52647090158f453c7359172591f
RUN git init -q /src \
    && cd /src && git remote add origin https://github.com/anchore/grype \
    && git fetch -q --depth 1 origin "$GRYPE_COMMIT" && git checkout -q FETCH_HEAD \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath \
       -ldflags "-s -w -X main.version=${GRYPE_VERSION#v}" -o /grype ./cmd/grype

FROM gcr.io/distroless/static-debian12:nonroot
COPY internal/infrastructure/report/assets/LiberationSans-LICENSE.txt /usr/share/licenses/synapse-ce/LiberationSans-LICENSE.txt
COPY --from=grype /grype /usr/local/bin/grype
COPY --from=build /out/synapse-cli /usr/local/bin/synapse-cli
ENV SYNAPSE_GRYPE_BIN=/usr/local/bin/grype
USER nonroot:nonroot
WORKDIR /scan
ENTRYPOINT ["/usr/local/bin/synapse-cli"]
CMD ["--help"]
