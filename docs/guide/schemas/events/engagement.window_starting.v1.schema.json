{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.kkloudtarus.net/docs/schemas/events/engagement.window_starting.v1.schema.json",
  "title": "engagement.window_starting event (v1)",
  "description": "An engagement authorization window is approaching its start.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "engagement.window_starting"
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "engagement_id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "engagement_id": {
          "type": "string",
          "minLength": 1
        },
        "lead_user_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "authorized_from": {
          "type": "string",
          "format": "date-time"
        },
        "authorized_to": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        },
        "boundary": {
          "type": "string",
          "enum": [
            "authorized_from"
          ]
        },
        "lead_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "engagement_name": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary",
        "engagement_id",
        "authorized_from",
        "boundary",
        "lead_time_seconds"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source_kind",
    "source_id",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "additionalProperties": true
}
