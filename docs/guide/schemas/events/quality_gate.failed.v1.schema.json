{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.kkloudtarus.net/docs/schemas/events/quality_gate.failed.v1.schema.json",
  "title": "quality_gate.failed event (v1)",
  "description": "A finalized project analysis failed its quality gate.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "quality_gate.failed"
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "summary",
        "analysis_id",
        "project_id"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source_kind",
    "source_id",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "additionalProperties": true
}
