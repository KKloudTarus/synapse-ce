{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.kkloudtarus.net/docs/schemas/events/report.generated.v1.schema.json",
  "title": "report.generated event (v1)",
  "description": "A report artifact was sealed from stored data.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "report.generated"
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "engagement_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "unknown"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "report_kind": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "engagement_id": {
          "type": "string"
        },
        "engagement_name": {
          "type": "string"
        },
        "report_title": {
          "type": "string"
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "title",
        "summary",
        "report_id",
        "report_kind",
        "content_hash",
        "generated_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source_kind",
    "source_id",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "additionalProperties": true
}
