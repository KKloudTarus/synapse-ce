{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.kkloudtarus.net/docs/schemas/events/notification.test.v1.schema.json",
  "title": "notification.test event (v1)",
  "description": "An on-demand channel test event.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "notification.test"
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "source_kind",
    "source_id",
    "schema_version",
    "occurred_at",
    "data"
  ],
  "additionalProperties": true
}
