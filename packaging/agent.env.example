# Synapse fleet VM agent configuration (installed to /etc/synapse-agent/agent.env, mode 0640
# root:synapse-agent). Populate before enabling the service. NEVER commit a real enrolment token.

# Control-plane fleet API. Must be https (a loopback host is the only http exception).
SYNAPSE_FLEET_URL=https://REPLACE-with-control-plane
# TLS-only bootstrap host. Defaults to SYNAPSE_FLEET_URL for local/development deployments.
SYNAPSE_FLEET_ENROL_URL=https://REPLACE-with-enrollment-endpoint

# One-time enrolment token, read from a file (preferred over an env value, which leaks via /proc).
# Provision the file out of band (mode 0600, owned by synapse-agent), then point at it here:
SYNAPSE_FLEET_ENROL_TOKEN_FILE=/etc/synapse-agent/enrol-token

# Optional display name; defaults to the hostname.
# SYNAPSE_AGENT_NAME=

# Optional Linux eBPF detection and signed delivery. The control plane must enable key registration
# and detection ingest. Leaving the engagement empty keeps detections durably local.
# SYNAPSE_DETECT_CLASSES=process,network,file,privilege
# SYNAPSE_DETECTION_ENGAGEMENT_ID=
# SYNAPSE_DETECTION_SHIP_INTERVAL=1s

# Optional governed process response. This is OFF by default. Enabling it requires the process detection
# class, a root/CAP_KILL runtime, and a root-managed trust bundle that is not group/world writable.
# SYNAPSE_RESPONSE_EXECUTION_ENABLED=true
# SYNAPSE_RESPONSE_COMMAND_TRUST_FILE=/etc/synapse-agent/response-command-trust.json
