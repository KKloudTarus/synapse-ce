# Synapse fleet VM agent configuration (installed to /etc/synapse-agent/agent.env, mode 0640
# root:synapse-agent). Populate before enabling the service. NEVER commit a real enrolment token.

# Control-plane fleet API. Must be https (a loopback host is the only http exception).
SYNAPSE_FLEET_URL=https://REPLACE-with-control-plane

# One-time enrolment token, read from a file (preferred over an env value, which leaks via /proc).
# Provision the file out of band (mode 0600, owned by synapse-agent), then point at it here:
SYNAPSE_FLEET_ENROL_TOKEN_FILE=/etc/synapse-agent/enrol-token

# Optional display name; defaults to the hostname.
# SYNAPSE_AGENT_NAME=
