# Non-secret production posture. The AMI build owns this file; runtime secrets are
# rendered separately into /etc/synapse-worker/runtime.env by the root-only bootstrap.
SYNAPSE_ENV=production
SYNAPSE_TOOL_EXECUTION_MODE=worker
SYNAPSE_SANDBOX_ENABLED=true
SYNAPSE_EGRESS_BROKER_SOCKET=/run/synapse-egress-broker/egress-broker.sock
# Private HTTPS endpoint served by synapse-api's dedicated machine-auth listener.
SYNAPSE_EGRESS_GRANT_AUTHORITY_URL=
SYNAPSE_DB_AUTO_MIGRATE=false
SYNAPSE_BLOB_USE_SSL=true
SYNAPSE_LEADER_ENABLED=true
SYNAPSE_METRICS_ENABLED=false
SYNAPSE_PROJECT_UPLOAD_DIR=/var/lib/synapse/project-uploads
SYNAPSE_PROJECT_SOURCE_ARTIFACT_DIR=/var/lib/synapse/project-source-artifacts
SYNAPSE_SCAN_CACHE_DIR=/var/cache/synapse/scan
SYNAPSE_SYFT_BIN=/opt/synapse/syft
SYNAPSE_GRYPE_BIN=/opt/synapse/grype
SYNAPSE_AST_BIN=/opt/synapse/synapse-ast
SYNAPSE_DAST_HELPER_BIN=/opt/synapse/synapse-dast-helper
SYNAPSE_CSPM_HELPER_BIN=/opt/synapse/synapse-cspm
SYNAPSE_TAINT_CALLGRAPH_BIN=/opt/synapse/synapse-callgraph
